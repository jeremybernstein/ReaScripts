  [linux-aarch64] automidireset/reaper_automidireset_aarch64.so > reaper_automidireset_aarch64.so
  [win64] automidireset/reaper_automidireset_x64.dll > reaper_automidireset_x64.dll
  [win32] automidireset/reaper_automidireset_w32.dll > reaper_automidireset_w32.dll
